{
  "name": "imovel-sp-mvp",
  "version": "0.1.0",
  "description": "Platform for comparing real estate prices in São Paulo",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "type-check": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:devcheck": "node scripts/run-devcheck-tests.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:ui": "node scripts/run-e2e.mjs --ui",
    "test:e2e:report": "playwright show-report",
    "check": "npm run type-check && npm run lint && npm run test:coverage",
    "health": "node scripts/health-check.js",
    "check:fast": "npm run test",
    "check:full": "npm run check && npm run build && npm run test:e2e",
    "check:integration": "npm run type-check && npm run test && npm run test:devcheck && npm run env:check:template",
    "check:security": "node scripts/security-check.mjs",
    "env:check": "node scripts/check-runtime-env.mjs --file .env.local",
    "env:check:production": "node scripts/check-runtime-env.mjs --file .env.local --production",
    "env:check:template": "node scripts/check-runtime-env.mjs --file .env.example --template",
    "vercel:env:pull:production": "npx vercel env pull .env.local --environment=production --yes",
    "vercel:smoke": "node scripts/smoke-production.mjs",
    "gate": "node scripts/run-devcheck.mjs approve",
    "gate:security": "node scripts/run-devcheck.mjs security",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "hooks:verify": "node scripts/verify-git-hooks.mjs",
    "feature:new": "node scripts/create-feature.js",
    "report:validation": "node scripts/generate-validation-report.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@supabase/supabase-js": "^2.40.0",
    "lucide-react": "^1.17.0",
    "next": "^16.2.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.77.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.0.0",
    "typescript": "^5",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "^0.35.3",
    "undici": "^7.28.0"
  }
}
